{
  "name": "ctrl-alt-design",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:cv": "node scripts/build-cv-pdf.mjs",
    "build": "next build",
    "vercel-build": "rm -rf .next/cache && next build",
    "start": "next start",
    "lint": "eslint",
    "audit:layout": "node scripts/audit-layout.mjs",
    "audit:frame": "node scripts/audit-frame.mjs",
    "audit:contain": "node scripts/audit-contain.mjs",
    "audit:sharp": "node scripts/audit-sharp.mjs",
    "audit:contrast": "node scripts/contrast-check.mjs",
    "audit:clip": "node scripts/clip-sweep.mjs",
    "audit:structure": "node scripts/audit-structure.mjs",
    "gate": "npm test && npm run audit:sync && npm run audit:structure && npm run audit:layout && npm run audit:frame && npm run audit:contain && npm run audit:clip && npm run audit:sharp && npm run audit:fonts && npm run audit:tokens && npm run audit:copy && npm run audit:reuse && npm run audit:nda && npm run audit:controls && npm run audit:parity && npm run audit:agents && npm run audit:contract && npm run audit:contrast && npm run audit:axe && npm run audit:type && npm run audit:visual && npm run audit:dark && npm run audit:order && npm run audit:debt",
    "audit:copy": "node scripts/audit-copy.mjs",
    "plan:review": "node scripts/plan-review.mjs",
    "audit:controls": "node scripts/audit-controls.mjs",
    "audit:nda": "node scripts/audit-nda.mjs",
    "audit:axe": "node scripts/audit-axe.mjs",
    "audit:type": "node scripts/audit-type.mjs && node scripts/audit-roles.mjs",
    "audit:visual": "node scripts/audit-visual.mjs",
    "audit:dark": "node scripts/audit-dark.mjs",
    "audit:reuse": "node scripts/audit-reuse.mjs",
    "audit:fonts": "node scripts/audit-fonts.mjs",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:agents": "node scripts/generate-agent-surfaces.mjs && node scripts/audit-agents.mjs",
    "prebuild": "node scripts/generate-agent-surfaces.mjs",
    "audit:parity": "node scripts/audit-parity.mjs",
    "audit:contract": "node scripts/audit-contract.mjs",
    "audit:debt": "node scripts/audit-debt.mjs",
    "test": "vitest run",
    "sync:bella": "node scripts/sync-bella.mjs",
    "audit:sync": "node scripts/sync-bella.mjs --check",
    "audit:static": "npm run audit:sync && npm run audit:layout && npm run audit:fonts && npm run audit:copy && npm run audit:reuse && npm run audit:nda && npm run audit:parity && npm run audit:agents && npm run audit:contract && npm run audit:debt",
    "check:fast": "tsc --noEmit && npm test && npm run audit:static",
    "audit:order": "playwright test && node scripts/audit-order.mjs",
    "build:favicons": "node scripts/build-favicons.mjs"
  },
  "dependencies": {
    "iconoir-react": "^7.11.1",
    "next": "^16.3.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-darwin-arm64": "^4.2.1"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "postcss": "^8.5.12"
  }
}

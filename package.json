    "audit:copy": "node scripts/audit-copy.mjs",
    "audit:controls": "node scripts/audit-controls.mjs",
    "audit:nda": "node scripts/audit-nda.mjs",
    "audit:axe": "node scripts/audit-axe.mjs",
    "audit:type": "node scripts/audit-type.mjs",
    "audit:reuse": "node scripts/audit-reuse.mjs",
    "audit:fonts": "node scripts/audit-fonts.mjs",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:agents": "node scripts/generate-agent-surfaces.mjs && node scripts/audit-agents.mjs",
